# Copy to .env. Never commit .env.
# Generate each secret with: openssl rand -hex 32
# Do not leave these placeholder strings in a running instance.

N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
N8N_RUNNERS_AUTH_TOKEN=replace-with-a-different-openssl-rand-hex-32

# Used only by scripts/send-sample-payloads.mjs.
# These are not passed into the n8n container.
WEBHOOK_URL=http://127.0.0.1:5678/webhook-test/leadflow
WEBHOOK_HEADER_NAME=X-Webhook-Secret
WEBHOOK_SECRET=replace-with-the-header-value-from-the-n8n-credential

AI_WEBHOOK_URL=http://127.0.0.1:5678/webhook-test/lead-summary
# Optional. Falls back to WEBHOOK_SECRET.
# AI_WEBHOOK_SECRET=replace-with-the-ai-webhook-header-value
